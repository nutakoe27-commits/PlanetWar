#version 450

// Треугольник без буфера вершин: координаты берутся по индексу.
// Для первого кадра это правильный минимум — проверяется весь путь от
// создания устройства до пикселей, и ни одна деталь не спрятана за
// загрузкой геометрии.

layout(location = 0) out vec3 vColor;

vec2 kPositions[3] = vec2[](
    vec2( 0.0, -0.62),
    vec2( 0.66, 0.55),
    vec2(-0.66, 0.55)
);

// Цвета вершин — из палитры проекта: янтарь чертёжной туши и холодная сталь
// корпусов. Заодно видно, что интерполяция и цветовое пространство работают.
vec3 kColors[3] = vec3[](
    vec3(0.910, 0.639, 0.239),
    vec3(0.373, 0.510, 0.753),
    vec3(0.290, 0.325, 0.400)
);

void main() {
    gl_Position = vec4(kPositions[gl_VertexIndex], 0.0, 1.0);
    vColor = kColors[gl_VertexIndex];
}
