{
  "version": 6,
  "cmakeMinimumRequired": { "major": 3, "minor": 25, "patch": 0 },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": { "PW_BUILD_TESTS": "ON" }
    },
    {
      "name": "linux-x64-debug",
      "displayName": "Linux x64 — отладка",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "PW_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "linux-x64-release",
      "displayName": "Linux x64 — релиз",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "windows-x64-debug",
      "displayName": "Windows x64 — отладка",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug", "PW_WARNINGS_AS_ERRORS": "ON" }
    },
    {
      "name": "windows-x64-release",
      "displayName": "Windows x64 — релиз",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "macos-arm64-release",
      "displayName": "macOS arm64 — релиз",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "arm64"
      }
    },
    {
      "name": "macos-x64-release",
      "displayName": "macOS x64 — релиз (маки на Intel)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_OSX_ARCHITECTURES": "x86_64"
      }
    },
    {
      "name": "server-linux-x64-release",
      "displayName": "Сервер Linux x64 — headless, без графики",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "PW_BUILD_CLIENT": "OFF",
        "PW_BUILD_EDITOR": "OFF"
      }
    },
    {
      "name": "android-arm64-release",
      "displayName": "Android arm64 — релиз (нужен ANDROID_NDK_HOME)",
      "inherits": "base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_TOOLCHAIN_FILE": "$env{ANDROID_NDK_HOME}/build/cmake/android.toolchain.cmake",
        "ANDROID_ABI": "arm64-v8a",
        "ANDROID_PLATFORM": "android-26",
        "PW_BUILD_TESTS": "OFF"
      }
    },
    {
      "name": "ios-arm64-release",
      "displayName": "iOS arm64 — релиз (только на macOS, нужен Xcode)",
      "generator": "Xcode",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "CMAKE_SYSTEM_NAME": "iOS",
        "CMAKE_OSX_ARCHITECTURES": "arm64",
        "PW_BUILD_TESTS": "OFF"
      }
    }
  ],
  "buildPresets": [
    { "name": "linux-x64-debug",        "configurePreset": "linux-x64-debug" },
    { "name": "linux-x64-release",      "configurePreset": "linux-x64-release" },
    { "name": "windows-x64-debug",      "configurePreset": "windows-x64-debug" },
    { "name": "windows-x64-release",    "configurePreset": "windows-x64-release" },
    { "name": "macos-arm64-release",    "configurePreset": "macos-arm64-release" },
    { "name": "macos-x64-release",      "configurePreset": "macos-x64-release" },
    { "name": "server-linux-x64-release", "configurePreset": "server-linux-x64-release" }
  ],
  "testPresets": [
    {
      "name": "linux-x64-debug",
      "configurePreset": "linux-x64-debug",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "linux-x64-release",
      "configurePreset": "linux-x64-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "windows-x64-release",
      "configurePreset": "windows-x64-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-arm64-release",
      "configurePreset": "macos-arm64-release",
      "output": { "outputOnFailure": true }
    },
    {
      "name": "macos-x64-release",
      "configurePreset": "macos-x64-release",
      "output": { "outputOnFailure": true }
    }
  ]
}
